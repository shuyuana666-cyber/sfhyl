# 端口号
VITE_PORT=5777

VITE_BASE=/admin/

# 接口地址
VITE_GLOB_API_URL=/api/v1
VITE_API_BASE_URL=/api/v1
VITE_SITE_URL=http://127.0.0.1:5173
VITE_MEDIA_BASE_PATH=/media
VITE_LEGACY_MEDIA_BUCKET=sfhyl
VITE_LEGACY_MEDIA_PORT=9200
VITE_APP_TITLE=SFHYL 运营管理
VITE_APP_NAMESPACE=sfhyl-admin
VITE_APP_VERSION=1.0.1
VITE_APP_STORE_SECURE_KEY=sfhyl-admin-browser-store

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
