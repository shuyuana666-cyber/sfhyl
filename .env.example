# Runtime
NODE_ENV=development
PORT=3002
HOST=127.0.0.1
API_PREFIX=api/v1
TZ=Asia/Shanghai
VITE_PUBLIC_API_BASE_URL=/api/v1
VITE_API_BASE_URL=http://localhost:3002/api/v1
VITE_ADMIN_URL=http://127.0.0.1:5777
VITE_SITE_URL=http://127.0.0.1:5173
VITE_MEDIA_BASE_PATH=/media
VITE_LEGACY_MEDIA_BUCKET=sfhyl
VITE_LEGACY_MEDIA_PORT=9200

# Public origins and URLs
ADMIN_WEB_URL=http://127.0.0.1:5777
WEBSITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3002
API_HOST_PORT=3002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5777

# MySQL 8.4. MYSQL_HOST_PORT is bound to localhost for development only.
MYSQL_DATABASE=sfhyl
MYSQL_USER=sfhyl
MYSQL_PASSWORD=replace_me_database_password
MYSQL_ROOT_PASSWORD=replace_me_root_password
MYSQL_HOST_PORT=3307
DATABASE_URL=mysql://sfhyl:replace_me_database_password@127.0.0.1:3307/sfhyl

# JWT and initial administrator. Use unique production secrets and a strong seed password.
JWT_ACCESS_SECRET=replace_me_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_me_with_a_different_32_character_secret
SETTINGS_ENCRYPTION_KEY=replace_me_with_a_unique_32_character_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
INQUIRY_RATE_LIMIT_TTL_MS=600000
INQUIRY_RATE_LIMIT_MAX=5
INQUIRY_DUPLICATE_WINDOW_MINUTES=10
# Public inquiry CAPTCHA. Keep disabled until the public site key and API secret are configured.
CAPTCHA_PROVIDER=disabled
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=
CAPTCHA_VERIFY_TIMEOUT_MS=8000
VITE_CAPTCHA_PROVIDER=disabled
VITE_CAPTCHA_SITE_KEY=

# Automatic Chinese-to-English/Russian translation for the admin editor.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSLATION_PROTOCOL=openai
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_strong_password

# Media storage for 1.0.1. Existing LOCAL files remain available at /uploads/.
STORAGE_DRIVER=minio
STORAGE_PUBLIC_URL=http://127.0.0.1:5173/media
LOCAL_STORAGE_PATH=./storage/uploads
# Use MINIO_MANAGED_EXTERNALLY=true when Docker or an external service runs MinIO.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9200
MINIO_CONSOLE_PORT=9201
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace_me_minio_access_key
MINIO_SECRET_KEY=replace_me_minio_secret_key
MINIO_BUCKET=sfhyl
MINIO_REGION=us-east-1
MINIO_PATH_STYLE=true
MINIO_SESSION_TOKEN=
MINIO_PUBLIC_READ=true
MINIO_MANAGED_EXTERNALLY=true
# Controls production activation only; stack:up:minio always starts local containers.
MINIO_COMPOSE_ENABLED=true

# Aliyun OSS skeleton (required only when STORAGE_DRIVER=aliyun-oss).
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=replace_me_aliyun_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace_me_aliyun_access_key_secret
ALIYUN_OSS_BUCKET=replace_me_aliyun_bucket
ALIYUN_OSS_PUBLIC_URL=https://replace-me.example.com

# Tencent COS skeleton (required only when STORAGE_DRIVER=tencent-cos).
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_SECRET_ID=replace_me_tencent_secret_id
TENCENT_COS_SECRET_KEY=replace_me_tencent_secret_key
TENCENT_COS_BUCKET=replace-me-1250000000
TENCENT_COS_PUBLIC_URL=https://replace-me.example.com

# Redis shares public caches and rate-limit counters across API instances.
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_me_redis_password
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=sfhyl:test
PUBLIC_CACHE_TTL_SECONDS=120
SYSTEM_LOG_PERSISTENCE_ENABLED=true
SYSTEM_LOG_FILE=./storage/logs/api.jsonl
SYSTEM_LOG_FILE_MAX_MB=20
SYSTEM_LOG_FILE_MAX_FILES=5
MEDIA_GENERATE_THUMBNAILS=true
MEDIA_THUMBNAIL_WIDTH=480
MEDIA_GENERATE_WEBP=true
MEDIA_IMAGE_MAX_DIMENSION=2560
MEDIA_WEBP_QUALITY=82
HOMEPAGE_DEFAULT_ASSETS_DIR=

# API safeguards
GLOBAL_RATE_LIMIT_TTL_MS=60000
GLOBAL_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=5
UPLOAD_MAX_IMAGE_MB=15
UPLOAD_MAX_VIDEO_MB=100
SWAGGER_ENABLED=true
INQUIRY_NOTIFICATION_EMAIL_ENABLED=false
INQUIRY_NOTIFICATION_WHATSAPP_ENABLED=false

# SMTP mail delivery. Credentials remain environment-only and are never returned by public APIs.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=replace_me_smtp_username
SMTP_PASSWORD=replace_me_smtp_password
MAIL_FROM_NAME=SFHYL
MAIL_FROM_ADDRESS=no-reply@example.com
