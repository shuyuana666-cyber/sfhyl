# Server-side secrets. Copy to /opt/sfhyl-platform/shared/.env with mode 600.
# Keep this file outside the public website/admin directories.
TZ=Asia/Shanghai
MYSQL_DATABASE=sfhyl
MYSQL_USER=sfhyl
MYSQL_PASSWORD=replace_me_url_safe_database_password
MYSQL_ROOT_PASSWORD=replace_me_unique_root_password
MYSQL_HOST_PORT=3307
REDIS_ENABLED=true
REDIS_PASSWORD=replace_me_unique_redis_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=sfhyl:production
JWT_ACCESS_SECRET=replace_me_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_me_with_a_different_32_character_secret
SETTINGS_ENCRYPTION_KEY=replace_me_with_a_stable_32_character_secret
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=replace_me_admin_email
SEED_ADMIN_PASSWORD=replace_me_strong_admin_password

# 1.0.1 target storage. Migrate existing LOCAL records with the verified migration command before retiring local files.
STORAGE_DRIVER=minio
STORAGE_PUBLIC_URL=https://sfhyl.cn/media
MINIO_ACCESS_KEY=replace_me_unique_minio_user
MINIO_SECRET_KEY=replace_me_unique_minio_password
MINIO_BUCKET=sfhyl
MINIO_REGION=us-east-1
MINIO_PATH_STYLE=true
MINIO_PUBLIC_READ=true
# Local MinIO containers. Set false and configure MINIO_INTERNAL_* for external S3.
MINIO_COMPOSE_ENABLED=true
MINIO_PORT=9200
MINIO_CONSOLE_PORT=9201

CORS_ORIGINS=https://sfhyl.cn
API_HOST_PORT=3002
CAPTCHA_PROVIDER=disabled
MAIL_ENABLED=false
SWAGGER_ENABLED=false
