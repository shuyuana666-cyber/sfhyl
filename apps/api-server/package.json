{
  "name": "@sfhyl/api-server",
  "version": "1.0.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed-brands": "tsx prisma/seed-brands.ts",
    "prisma:import-legacy": "tsx prisma/import-legacy.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "10.4.20",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.20",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/swagger": "8.1.1",
    "@nestjs/terminus": "10.3.0",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "file-type": "21.3.2",
    "helmet": "8.1.0",
    "ioredis": "5.6.1",
    "joi": "17.13.6",
    "minio": "8.0.7",
    "multer": "2.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.20",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.13",
    "@types/node": "24.1.0",
    "@types/passport-jwt": "4.0.1",
    "@types/sanitize-html": "2.16.0",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.38.0",
    "@typescript-eslint/parser": "8.38.0",
    "dotenv": "16.4.5",
    "eslint": "9.32.0",
    "jest": "29.7.0",
    "prisma": "6.19.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.2.5",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^file-type$": "<rootDir>/test/jest-native-file-type.cjs",
      "^sanitize-html$": "<rootDir>/test/jest-native-sanitize-html.cjs"
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
