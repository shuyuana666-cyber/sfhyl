{
  "name": "sfhyl2",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "body-parser@^1.20.0": "1.20.6",
      "decode-uri-component": "0.5.0",
      "fast-xml-parser@^5.0.0": "5.7.0",
      "file-type": "21.3.2",
      "effect": "3.22.2",
      "js-yaml@^4.0.0": "4.3.2",
      "lodash@^4.0.0": "4.18.0",
      "multer": "2.3.0",
      "nanoid@^3.0.0": "3.3.18",
      "path-to-regexp@0.1": "0.1.13",
      "postcss@^8.0.0": "8.5.23",
      "qs@^6.0.0": "6.16.0",
      "stream-json@^3.0.0": "3.5.0"
    }
  },
  "description": "SFHYL.CN vehicle catalogue UI built with React and Vite.",
  "main": "index.html",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "pnpm --filter @sfhyl/api-server start:dev",
    "dev:website": "vite --host 127.0.0.1",
    "start": "pnpm --filter @sfhyl/api-server start",
    "lint": "pnpm api:lint && pnpm admin:lint && pnpm admin:stylelint",
    "typecheck": "pnpm api:typecheck && pnpm admin:typecheck",
    "test": "pnpm test:unit && pnpm api:test:e2e && pnpm test:browser",
    "test:unit": "pnpm api:test && pnpm admin:test",
    "test:browser": "playwright test",
    "build": "pnpm build:website && pnpm admin:build && pnpm api:build",
    "build:website": "vite build",
    "api:dev": "pnpm --filter @sfhyl/api-server start:dev",
    "api:build": "pnpm --filter @sfhyl/api-server build",
    "api:lint": "pnpm --filter @sfhyl/api-server lint",
    "api:typecheck": "pnpm --filter @sfhyl/api-server typecheck",
    "api:test": "pnpm --filter @sfhyl/api-server test",
    "api:test:e2e": "pnpm --filter @sfhyl/api-server test:e2e",
    "admin:dev": "node scripts/admin-vben.mjs dev",
    "admin:build": "node scripts/admin-vben.mjs build",
    "admin:lint": "node scripts/admin-vben.mjs lint",
    "admin:stylelint": "pnpm --filter @sfhyl/admin-web exec stylelint \"src/**/*.{vue,css,scss}\" --max-warnings 0",
    "admin:test": "pnpm --filter @sfhyl/admin-web test",
    "admin:typecheck": "node scripts/admin-vben.mjs typecheck",
    "admin:vben:install": "node scripts/admin-vben.mjs install",
    "preview": "vite preview --host 127.0.0.1",
    "infra:up": "docker compose up -d mysql redis",
    "infra:up:minio": "docker compose --profile minio up -d mysql redis minio minio-init",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @sfhyl/api-server prisma:generate",
    "db:validate": "pnpm --filter @sfhyl/api-server prisma:validate",
    "db:migrate": "pnpm --filter @sfhyl/api-server prisma:migrate",
    "db:deploy": "pnpm --filter @sfhyl/api-server prisma:deploy",
    "db:seed": "pnpm --filter @sfhyl/api-server prisma:seed",
    "db:seed-brands": "pnpm --filter @sfhyl/api-server prisma:seed-brands",
    "infra:init": "node scripts/infrastructure.mjs init",
    "infra:check": "node scripts/infrastructure.mjs check",
    "stack:up:minio": "docker compose --profile minio -f docker-compose.yml -f docker-compose.minio.yml up -d --build api",
    "media:migrate:minio": "node scripts/migrate-media-to-minio.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright-core": "^1.61.1",
    "vite": "^8.1.5"
  }
}
